# API: set these in the terminal running npm run dev:api. No production adapters exist yet.
I2V_MODE=local
I2V_HOST=127.0.0.1
I2V_PORT=4100
I2V_DATABASE=.local/i2v.sqlite
I2V_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Physical device: explicit opt-in permits local registration over your trusted LAN.
# I2V_ALLOW_LAN=1
# I2V_HOST=0.0.0.0
# Mobile apps/mobile/.env only: use the PC's LAN IPv4, never localhost on an iPhone.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4100

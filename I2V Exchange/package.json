{
  "name": "i2v-exchange", "version": "0.1.0", "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.13.0 <25" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @i2v/api",
    "dev:web": "npm run dev -w @i2v/web",
    "dev:mobile": "npm run start -w @i2v/mobile",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json",
    "lint": "eslint apps packages tests scripts/*.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build -w @i2v/web",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "admin": "tsx apps/api/src/admin.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0", "@playwright/test": "^1.56.1", "@types/node": "^24.10.0",
    "@types/react": "~19.1.10", "@types/react-dom": "~19.1.9", "concurrently": "^9.2.1",
    "eslint": "^9.39.0", "globals": "^16.5.0", "tsx": "^4.20.6", "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2", "vitest": "^4.0.3"
  }
}

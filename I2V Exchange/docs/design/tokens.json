{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_note": "Provisional, non-branded design token suggestions; verify WCAG contrast in actual component pairings.",
  "font": {
    "familyUi": "Inter, system-ui, -apple-system, Segoe UI, sans-serif",
    "familyEditorial": "Georgia, ui-serif, serif",
    "scaleRem": {
      "xs": 0.75,
      "sm": 0.875,
      "body": 1,
      "lg": 1.125,
      "h3": 1.5,
      "h2": 2,
      "h1": 3.25
    }
  },
  "spacingPx": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "base": 16,
    "lg": 24,
    "xl": 32,
    "2xl": 48,
    "3xl": 64
  },
  "radiusPx": {
    "sm": 8,
    "md": 12,
    "lg": 20,
    "xl": 28,
    "pill": 9999
  },
  "breakpointsPx": {
    "small": 360,
    "tablet": 768,
    "desktop": 1120,
    "wide": 1440
  },
  "motionMs": {
    "fast": 120,
    "normal": 200,
    "slow": 320
  },
  "light": {
    "bg": "#F7F6F2",
    "surface": "#FFFFFF",
    "surfaceMuted": "#EFEEE8",
    "text": "#192421",
    "mutedText": "#52625C",
    "border": "#CFD8D1",
    "primary": "#154F42",
    "onPrimary": "#FFFFFF",
    "accent": "#CCF26C",
    "onAccent": "#182816",
    "warning": "#714B00",
    "error": "#A52B2B",
    "focus": "#155CC4"
  },
  "dark": {
    "bg": "#0D1715",
    "surface": "#15221F",
    "surfaceMuted": "#21332E",
    "text": "#F2F7F3",
    "mutedText": "#B5C3BC",
    "border": "#436054",
    "primary": "#B9E2CE",
    "onPrimary": "#102118",
    "accent": "#CCF26C",
    "onAccent": "#142713",
    "warning": "#EFC473",
    "error": "#F5A7A3",
    "focus": "#93BCFF"
  },
  "elevation": {
    "low": "0 4px 16px rgb(0 0 0 / 0.06)",
    "high": "0 12px 42px rgb(0 0 0 / 0.12)"
  },
  "projectMedia": {
    "cardRatio": "4 / 3",
    "detailHeroRatio": "16 / 9",
    "subjectRule": "Prefer real project photos/demos with user rights and credible attribution."
  }
}
